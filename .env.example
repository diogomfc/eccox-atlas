# Banco de dados — Postgres 16 (docker-compose sobe na porta 5435)
DATABASE_URL="postgresql://atlas:atlas-dev@localhost:5435/eccox_atlas"

# Auth.js v5
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Microsoft Entra ID. Enquanto o App Registration nao estiver pronto, deixe
# NEXT_PUBLIC_AUTH_ENTRA_ENABLED=false para usar os usuarios mock de desenvolvimento.
#
# Quando ligar: o Redirect URI /api/auth/callback/microsoft homologado com a TI
# so existe para porta 3000 (mesmo App Registration do eci-studio-frontend) —
# por isso o Atlas roda na 3000 tambem (ver "dev"/"start" em package.json).
# Nao da pra ter os dois projetos de pe ao mesmo tempo sem o TI cadastrar um
# novo Redirect URI para outra porta.
NEXT_PUBLIC_AUTH_ENTRA_ENABLED="false"
AUTH_URL="http://localhost:3000"
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# O primeiro login vira GESTOR automaticamente (bootstrap). Preencha aqui os
# e-mails que devem SEMPRE entrar como GESTOR, mesmo que alguem os rebaixe sem
# querer pela tela de administracao. Separados por virgula.
ATLAS_ROOT_EMAILS=""

# Diretorio completo de colaboradores (picker de convite) — precisa do escopo
# User.Read.All com consentimento de admin do tenant. Deixe "false" ate o TI
# confirmar; ligar sem o consentimento trava o login inteiro. Ver
# src/lib/auth/entra-enabled.ts.
NEXT_PUBLIC_ENTRA_DIRECTORY_ENABLED="false"

# OpenRouter
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-4.5"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# URL publica usada para montar os links de entrevista
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# MinIO — servidor compartilhado da ECCOX (nao e um servico novo pra subir no
# docker-compose, ja existe na rede). Bucket exclusivo do Atlas pra nao
# misturar com eccox-avatars/eccox-news.
MINIO_ENDPOINT=""
MINIO_PORT="9000"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_USE_SSL="false"
MINIO_BUCKET_EVIDENCES="eccox-atlas-evidencias"

# ECI — agente de governanca publicado no ECI Studio (opcional).
# Com as tres variaveis preenchidas, o Codice passa a mostrar o parecer de
# doutrina vindo do agente. Sem elas, o Atlas roda inteiro no OpenRouter e o
# parecer simplesmente nao aparece. So chamadas de texto livre passam pelo ECI:
# o canal API de la nao aceita schema. Ver docs/ARQUITETURA-IA.md.
ECI_BASE_URL=""
ECI_AGENT_CODE=""
ECI_API_KEY=""
